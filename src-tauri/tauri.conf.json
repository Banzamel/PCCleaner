{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Cleaner",
  "mainBinaryName": "PCCleaner",
  "version": "../package.json",
  "identifier": "pl.banzamel.pccleaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "PC Cleaner",
        "width": 1240,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Banzamel",
    "homepage": "https://github.com/Banzamel/PCCleaner",
    "copyright": "MIT License",
    "shortDescription": "PC Cleaner",
    "longDescription": "Smart Windows cleanup with a local AI assistant.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "Polish", "Spanish"],
        "displayLanguageSelector": true,
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxNkE4RTM4NTc4NEEyQjgKUldTNG9vUlhPSTVxQWZXZGJUdkwremFhenVIcDdoVWdrUUZqQ3FYZ2ppU2dPbnlJVnB5emVaMXYK",
      "endpoints": ["https://github.com/Banzamel/PCCleaner/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
